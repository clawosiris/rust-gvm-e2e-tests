FROM rust:1.89

ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV PATH="/usr/local/cargo/bin:${PATH}"

ARG RUST_GVM_SHA=cd4689cab8875ea1a0d7b35cd5a5038416f0e8e0
ARG GVM_ROOLS_REF=main

LABEL org.opencontainers.image.source="https://github.com/clawosiris/rust-gvm-e2e-tests" \
      org.opencontainers.image.revision="${RUST_GVM_SHA}"

ENV RUST_GVM_SHA="${RUST_GVM_SHA}"

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates bash git pkg-config libssl-dev socat python3 python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --break-system-packages python-gvm

COPY Cargo.toml /tmp/rust-gvm-e2e-tests/Cargo.toml
COPY tests/library/Cargo.toml /tmp/rust-gvm-e2e-tests/tests/library/Cargo.toml
COPY Cargo.lock /tmp/rust-gvm-e2e-tests/Cargo.lock
COPY tests/library/src /tmp/rust-gvm-e2e-tests/tests/library/src
COPY contracts /tmp/rust-gvm-e2e-tests/contracts
COPY coverage/feature-catalog.json /tmp/rust-gvm-e2e-tests/coverage/feature-catalog.json
COPY fixtures /tmp/rust-gvm-e2e-tests/fixtures
COPY tools/prepare_rust_gvm_candidate.py /tmp/rust-gvm-e2e-tests/tools/prepare_rust_gvm_candidate.py

RUN --mount=type=secret,id=github_token \
    GIT_CONFIG_GLOBAL=/tmp/github-auth.gitconfig; \
    export GIT_CONFIG_GLOBAL; \
    if [ -f /run/secrets/github_token ]; then \
      TOKEN=$(cat /run/secrets/github_token); \
      git config --global url."https://x-access-token:${TOKEN}@github.com/".insteadOf "https://github.com/"; \
    fi \
    && echo "Pinned rust-gvm SHA: ${RUST_GVM_SHA}" \
    && echo "${RUST_GVM_SHA}" | grep -qE '^[0-9a-f]{40}$' \
    && python3 /tmp/rust-gvm-e2e-tests/tools/prepare_rust_gvm_candidate.py \
         --workspace-manifest /tmp/rust-gvm-e2e-tests/Cargo.toml \
         --library-manifest /tmp/rust-gvm-e2e-tests/tests/library/Cargo.toml \
         --lockfile /tmp/rust-gvm-e2e-tests/Cargo.lock \
         --sha "${RUST_GVM_SHA}" \
    && cargo install --locked --path /tmp/rust-gvm-e2e-tests/tests/library --bin gvm-community-e2e \
    && git clone --branch "${GVM_ROOLS_REF}" --depth 1 https://github.com/clawosiris/gvm-rools.git /tmp/gvm-rools \
    && cargo build --release --manifest-path /tmp/gvm-rools/Cargo.toml --bin gvm-cli \
    && install -m 0755 /tmp/gvm-rools/target/release/gvm-cli /usr/local/cargo/bin/gvm-cli \
    && rm -rf /tmp/rust-gvm-e2e-tests /tmp/gvm-rools \
    && rm -f "${GIT_CONFIG_GLOBAL}" \
    && test -x /usr/local/cargo/bin/gvm-community-e2e \
    && test -x /usr/local/cargo/bin/gvm-cli \
    && echo "Installed binaries:" && ls -la /usr/local/cargo/bin/

CMD ["/bin/bash", "-l"]
